{
  "author": "RedKubes",
  "bugs": {
    "url": "https://github.com/linode/apl-clients/issues"
  },
  "description": "Factory to build and publish openapi and gRPC clients used in the apl-clients repo. Part of the APL Container Platform.",
  "devDependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@grpc/grpc-js": "^1.14.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "git-cz": "^4.9.0",
    "grpc-tools": "^1.13.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "ts-proto": "^2.12.1",
    "typescript": "5.9.3"
  },
  "homepage": "https://github.com/linode/apl-clients#readme",
  "engines": {
    "node": ">=24 <25",
    "npm": "^11"
  },
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "main": "",
  "name": "apl-clients",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linode/apl-clients.git"
  },
  "run-if-changed": {
    "package-lock.json": "npm install --prefer-offline --no-audit"
  },
  "scripts": {
    "build": "bin/generate-all.sh",
    "release": "bin/release-all.sh",
    "prepare": "husky"
  },
  "version": "0.1.0",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "allowScripts": {
    "grpc-tools@1.13.1": true,
    "protobufjs@7.6.6": true
  }
}
